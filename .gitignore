```gitignore
# =========================
# Environment Variables
# =========================
.env
.env.*
!.env.example

# =========================
# Python / FastAPI Backend
# =========================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
venv/
.venv/
env/
ENV/
v-env/
v-ai/

# Python Packaging
build/
dist/
*.egg-info/
.eggs/

# Testing and Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Jupyter Notebook
.ipynb_checkpoints/

# Logs
*.log
logs/

# =========================
# Node.js / React Frontend
# =========================
node_modules/
dist/
build/
.vite/
coverage/
.npm/

# Package Manager Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# =========================
# IDE / Editor
# =========================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# =========================
# AI / ML Artifacts
# =========================
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.gguf

# Model Cache Directories
.cache/
huggingface_cache/
model_cache/

# =========================
# Generated Data / Indexes
# =========================
chroma_db/
chroma/
vectorstore/
vector_store/
embeddings/
indexes/

# Generated Graphs and Outputs
generated/
outputs/
temp/
tmp/

# =========================
# Repository Processing
# =========================
cloned_repos/
cloned_repositories/
repository_cache/

# =========================
# OS Files
# =========================
.DS_Store
Thumbs.db
desktop.ini
```
